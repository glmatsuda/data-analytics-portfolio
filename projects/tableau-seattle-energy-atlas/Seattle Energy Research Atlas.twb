      <column name="[Peer P90 WN EUI]" datatype="real" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Relative to Peer]" datatype="real" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Peer Percentile]" datatype="real" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Eligible GHG]" datatype="integer" role="measure" type="quantitative" default-format="p0.0%" />
      <column name="[Eligibility Reason]" datatype="string" role="dimension" type="nominal" />
      <column name="[Log10 floor area]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Floor Area sqft] &gt; 0 THEN LOG([Floor Area sqft]) END" />
      </column>
      <column name="[Log10 peer ratio]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Relative to Peer] &gt; 0 THEN LOG([Relative to Peer]) END" />
      </column>
      <column name="[Eligible WN EUI]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Eligible EUI] = 1 THEN [WN EUI] END" />
      </column>
      <column name="[Continuous-cohort WN EUI]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [Matched Cohort] = 1 THEN [WN EUI] END" />
      </column>
      <column name="[Cohort baseline EUI]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [Building ID] : MAX(IF [Reporting Year] = 2019 AND [Matched Cohort] = 1 THEN [WN EUI] END) }" />
      </column>
      <column name="[Cohort comparison EUI]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [Building ID] : MAX(IF [Reporting Year] = 2024 AND [Matched Cohort] = 1 THEN [WN EUI] END) }" />
      </column>
      <column name="[Cohort building change]" datatype="real" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="[Cohort comparison EUI] / [Cohort baseline EUI] - 1" />
      </column>
      <column name="[Cohort use N]" datatype="real" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [Property Use] : COUNTD(IF [Matched Cohort] = 1 THEN [Building ID] END) }" />
      </column>
