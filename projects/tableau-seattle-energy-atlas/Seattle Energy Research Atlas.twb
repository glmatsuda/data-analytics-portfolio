      <column name="[Demolished]" datatype="integer" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Source Row]" datatype="integer" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Eligible EUI]" datatype="integer" role="measure" type="quantitative" default-format="p0.0%" />
      <column name="[Matched Cohort]" datatype="integer" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Peer Count]" datatype="integer" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column name="[Peer Benchmark Available]" datatype="integer" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
